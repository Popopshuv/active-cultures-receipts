# Copy to .env.local and fill in. Nothing here is NEXT_PUBLIC_ on purpose:
# the Strava client secret and the printer token must never reach the browser.

# --- Strava -------------------------------------------------------------------
# From strava.com/settings/api. Set the app's "Authorization Callback Domain"
# to this site's bare host (no scheme, no path). Strava whitelists localhost
# separately, so development needs no extra configuration.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Pi print server ----------------------------------------------------------
# Public URL of the Pi, via its Cloudflare Tunnel.
PRINTER_URL=https://printer.yourdomain.com
# Must match PRINT_TOKEN in pi-server/.env. Generate: openssl rand -hex 32
PRINTER_TOKEN=

# --- This app -----------------------------------------------------------------
# Signs the session and CSRF cookies. Generate: openssl rand -hex 32
SESSION_SECRET=
# Gates /control. Anyone with this can clear the print queue, so make it
# something you'd be comfortable reading aloud in a shop but not guessing.
OPERATOR_PASSCODE=

# Canonical origin, used to build the OAuth redirect URI. Vercel sets
# VERCEL_PROJECT_PRODUCTION_URL automatically, so this is mostly for local dev
# and custom domains.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
