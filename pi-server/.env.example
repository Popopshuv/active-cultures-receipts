# Required. Shared bearer token; the same value goes in the web app's env as
# PRINTER_TOKEN (note: not NEXT_PUBLIC_ — it must never reach the browser).
# Generate with: openssl rand -hex 32
PRINT_TOKEN=

# Where job bitmaps and the sqlite queue live. Must be writable by the service
# user and on storage that survives a reboot.
PRINT_QUEUE_DIR=/home/pi/active-cultures/queue

# Soft per-IP cap on job submissions. Every job arrives from the web app, so
# this is really a cap on the whole site, not per runner.
PRINT_RATE_PER_MIN=30

# USB ids of the thermal printer (find with `lsusb`).
PRINTER_VID=0x6868
PRINTER_PID=0x0200

# 384 = 58mm at 203 DPI. 576 for an 80mm printer — and change HEAD_DOTS in the
# web app's src/lib/receiptConfig.ts to match, or receipts print at the wrong
# scale.
PRINTER_HEAD_DOTS=384

# Blank lines fed after each receipt so it clears the tear bar.
PRINTER_FEED=6

# 1 if the printer has an auto-cutter. Most cheap 58mm units don't.
PRINTER_CUT=0

# Grey level that becomes black, 0-255. Tuned by sweeping against the real
# font: below ~170 the small attribution type breaks into fragments, above
# ~210 it blobs shut. Lower this if the print looks too heavy, raise it if
# thin strokes come out broken. Photos are unaffected either way — they arrive
# already dithered to pure black and white.
PRINT_THRESHOLD=190

# Dot rows of white kept below the receipt after cropping.
PRINT_BOTTOM_MARGIN=8

# 1 writes each bitmap to PRINT_QUEUE_DIR instead of the printer. This is how
# you develop the whole server on a laptop with no hardware attached.
PRINTER_DRY_RUN=0
